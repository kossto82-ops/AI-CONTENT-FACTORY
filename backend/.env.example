# AI Content Factory — environment (copy to .env)
# Example values shown; adjust to your machine.

# OmniRoute local gateway (Anthropic-compatible surface)
OMNIROUTE_URL=http://127.0.0.1:20128
# Dummy token accepted for localhost in dev; never a real secret in code.
OMNIROUTE_API_KEY=sk-omniroute-local

# Local SQLite database file (created on first run)
FACTORY_DB=./data/factory.db

# Default routing tier for the pipeline ("cheap" | "standard" | "quality")
FACTORY_DEFAULT_TIER=cheap

# Max retries per job before the pipeline marks it failed
FACTORY_MAX_RETRIES=2

# Base duration for vertical shorts (seconds)
SHORT_DURATION_SECONDS=30
